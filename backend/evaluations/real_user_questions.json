    {
      "id": "reference_current_drawing",
      "kind": "reference",
      "category": "reference_resolution",
      "message": "继续修改这个图纸",
      "memory": [
        {"message": "", "result": {"file_name": "court_v003.json"}}
      ],
      "expected": {
        "resolved": true,
        "ambiguous": false,
        "target_type": "drawing",
        "target_id": "court_v003.json"
      }
    },
    {
      "id": "reference_previous_variant",
      "kind": "reference",
      "category": "reference_resolution",
      "message": "使用上一个方案",
      "memory": [
        {"message": "", "result": {"variant_id": "variant-a"}},
        {"message": "", "result": {"variant_id": "variant-b"}}
      ],
      "expected": {
        "resolved": true,
        "ambiguous": false,
        "target_type": "variant",
        "target_id": "variant-a"
      }
    },
    {
      "id": "reference_missing_object",
      "kind": "reference",
      "category": "reference_resolution",
      "message": "继续修改它",
      "memory": [],
      "expected": {
        "resolved": false,
        "ambiguous": true,
        "target_type": null,
        "target_id": null
      }
    },
    {
      "id": "stale_energy_must_not_be_current",
      "kind": "answer",
      "category": "degraded_data",
      "answer": "当前电量为 86%，能源状态正常。",
      "route": {"name": "status_query"},
      "context": {
        "quality": {"requested_domains": ["energy"], "blocked_domains": ["energy"]},
        "telemetry": {"energy": {"battery_percent": 86}}
      },
      "expected": {
        "issue_codes": ["stale_or_missing_live_data"],
        "message_changed": true,
        "required_text": ["无法确认当前能源状态"],
        "forbidden_text": ["当前电量为 86%"]
      }
    },
    {
      "id": "fresh_energy_corrects_hallucination",
      "kind": "answer",
      "category": "factual_consistency",
      "answer": "当前电量为 90%，电压为 30V。",
      "route": {"name": "status_query"},
      "context": {
        "quality": {"requested_domains": ["energy"], "blocked_domains": []},
        "telemetry": {"energy": {"battery_percent": 62, "voltage": 24.6}}
      },
      "expected": {
        "issue_codes": ["numeric_fact_mismatch"],
        "message_changed": true,
        "required_text": ["62%", "24.6V"],
        "forbidden_text": ["90%", "30V"]
      }
    },
    {
      "id": "submitted_is_not_completed",
      "kind": "answer",
      "category": "tool_verification",
      "answer": "操作成功，小车已经启动。",
      "route": {"name": "motion_control"},
      "context": {"quality": {"requested_domains": [], "blocked_domains": []}},
      "tool_results": [
        {"verification": {"status": "pending", "verified": false}}
      ],
      "expected": {
        "issue_codes": ["unverified_completion_claim"],
        "message_changed": true,
        "required_text": ["等待设备反馈"],
        "forbidden_text": ["操作成功", "已经启动"]
      }
    },
    {
      "id": "pending_confirmation_is_not_completed",
      "kind": "answer",
      "category": "tool_verification",
      "answer": "喷墨已经打开。",
      "route": {"name": "printer_control"},
      "context": {"quality": {"requested_domains": [], "blocked_domains": []}},
      "pending_action": {"id": "pending-1", "name": "printer_spray"},
      "expected": {
        "issue_codes": ["unverified_completion_claim"],
        "message_changed": true,
        "required_text": ["需要用户确认"],
        "forbidden_text": ["已经打开"]
      }
    },
    {
