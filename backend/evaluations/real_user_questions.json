      "route": {"name": "conversation"},
      "context": {"quality": {"requested_domains": [], "blocked_domains": []}},
      "knowledge_source_ids": ["K1"],
      "expected": {
        "issue_codes": ["unknown_source_citation"],
        "message_changed": true,
        "forbidden_text": ["[K9]"]
      }
    },
    {
      "id": "failed_tool_is_not_completed",
      "kind": "answer",
      "category": "api_failure_recovery",
      "answer": "操作成功，喷码机已经打开。",
      "route": {"name": "printer_control"},
      "context": {"quality": {"requested_domains": [], "blocked_domains": []}},
      "tool_results": [
        {"verification": {"status": "failed", "verified": false, "reason_code": "printer_disconnected"}}
