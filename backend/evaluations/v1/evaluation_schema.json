{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad.d0.evaluation-record.v1",
  "title": "Natural Language CAD Agent D0 six-dimension evaluation record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "case_id",
    "input_sha256",
    "evidence_mode",
    "expected_route",
    "actual_route",
    "model",
    "planning",
    "source",
    "geometry",
    "acceptance",
    "version",
    "final_outcome",
    "failure_category"
  ],
  "properties": {
    "schema_version": {
      "const": "cad.d0.evaluation-record.v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_mode": {
      "enum": [
        "mock",
        "reconstructed_fixture",
        "historical_report",
        "rule_parser_zero_cost",
        "live_model",
        "unavailable"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "planning": {
      "$ref": "#/$defs/planning"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "final_outcome": {
      "enum": [
        "passed",
        "failed",
        "not_run",
        "unknown",
        "collection_blocked",
        "environment_blocked"
      ]
    },
    "outcome_scope": {
      "type": "string"
    },
    "failure_category": {
      "anyOf": [
        {
          "enum": [
            "self_intersection",
            "constraint_loss",
            "c1_continuity",
            "route_misclassification",
            "source_acceptance_gap",
            "clarification_required",
            "benchmark_expectation_mismatch",
            "collection_blocked",
            "environment_blocked",
            "checkpoint_contract_mismatch",
            "unfrozen_case_definition",
            "http_e2e_unverified",
            "not_applicable",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "called",
        "provider",
        "model",
        "request_ref",
        "response_ref",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "properties": {
        "called": {
          "type": "boolean"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "route",
        "requirement_contract_ref",
        "requirement_ledger_ref",
        "structured_plan_hash",
        "parser",
        "status"
      ],
      "properties": {
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirement_contract_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirement_ledger_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "structured_plan_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parser": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "expected_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "failed_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "conversation_id",
        "source_ids",
        "h3_status",
        "evidence_refs"
      ],
      "properties": {
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "h3_status": {
          "enum": [
            "passed",
            "failed",
            "not_checked",
            "unknown",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "geometry_hash",
        "geometry_count",
        "closed",
        "self_intersection_count",
        "continuity",
        "bounds",
        "error_code"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_checked",
            "unknown",
            "not_applicable"
          ]
        },
        "geometry_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_count": {
          "type": "integer",
          "minimum": 0
        },
        "closed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "self_intersection_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "continuity": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "required",
            "measured",
            "passed",
            "max_tangent_delta_deg"
          ],
          "properties": {
            "required": {
              "type": [
                "string",
                "null"
              ]
            },
            "measured": {
              "type": [
                "string",
                "null"
              ]
            },
            "passed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "max_tangent_delta_deg": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "bounds": {
          "type": [
            "object",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "h2",
        "h3",
        "h4"
      ],
      "properties": {
        "h2": {
          "$ref": "#/$defs/dimension"
        },
        "h3": {
          "$ref": "#/$defs/dimension"
        },
        "h4": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_checked",
            "unknown",
            "not_applicable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "project_id",
        "candidate_id",
        "parent_version_id",
        "version_id",
        "final_version_status",
        "project_persistence"
      ],
      "properties": {
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_version_status": {
          "enum": [
            "not_persisted",
            "created",
            "saved",
            "failed",
            "unknown"
          ]
        },
        "project_persistence": {
          "type": "boolean"
        }
      }
    }
  }
}