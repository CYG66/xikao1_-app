+GEOMETRY_GRAPH_JUNCTION_TOLERANCE_MM = 1e-6
+
+
+def _path_points_mm(item: dict[str, Any]) -> list[tuple[float, float]]:
+    return [
+        (float(point[0]) * 1000.0, float(point[1]) * 1000.0)
+        for point in item.get("points") or []
+    ]
+
+
+def _build_geometry_graph(path_items: list[dict[str, Any]]) -> dict[str, Any]:
+    """Build a path-edge graph using true Euclidean endpoint distance.
+
+    The legacy topology counters keep their grid-based semantics.  This graph
+    is the additive, authoritative connectivity view: a junction is formed
+    only when two path endpoints are within the fixed 1e-6 mm tolerance.
+    """
+    tolerance_mm = GEOMETRY_GRAPH_JUNCTION_TOLERANCE_MM
+    endpoint_records: list[dict[str, Any]] = []
+    path_records: list[dict[str, Any]] = []
+
+    for path_index, item in enumerate(path_items):
+        points = _path_points_mm(item)
+        if len(points) < 2:
+            continue
+        closed = math.dist(points[0], points[-1]) <= tolerance_mm
+        start_record = len(endpoint_records)
+        endpoint_records.append({
+            "point": points[0],
+            "path_index": path_index,
+            "geometry_id": item.get("geometry_id"),
+            "side": "closed" if closed else "start",
+        })
+        if closed:
+            end_record = start_record
+        else:
+            end_record = len(endpoint_records)
+            endpoint_records.append({
+                "point": points[-1],
+                "path_index": path_index,
+                "geometry_id": item.get("geometry_id"),
+                "side": "end",
+            })
+        path_records.append({
+            "path_index": path_index,
+            "geometry_id": item.get("geometry_id"),
+            "geometry_type": str(item.get("geometry_type") or "line").lower(),
+            "points": points,
+            "closed": closed,
+            "start_record": start_record,
+            "end_record": end_record,
+            "length_mm": sum(
+                math.dist(left, right) for left, right in zip(points, points[1:])
+            ),
+        })
+
+    parents = list(range(len(endpoint_records)))
+
+    def find(index: int) -> int:
+        while parents[index] != index:
+            parents[index] = parents[parents[index]]
+            index = parents[index]
+        return index
+
+    def union(left: int, right: int) -> None:
+        left_root, right_root = find(left), find(right)
+        if left_root != right_root:
+            parents[right_root] = left_root
+
+    for left_index in range(len(endpoint_records)):
+        for right_index in range(left_index + 1, len(endpoint_records)):
+            if math.dist(
+                endpoint_records[left_index]["point"],
+                endpoint_records[right_index]["point"],
+            ) <= tolerance_mm:
+                union(left_index, right_index)
+
+    clusters: dict[int, list[int]] = {}
+    for index in range(len(endpoint_records)):
+        clusters.setdefault(find(index), []).append(index)
+
+    nodes: list[dict[str, Any]] = []
+    node_by_record: dict[int, str] = {}
+    for cluster_index, (_, members) in enumerate(
+        sorted(clusters.items(), key=lambda pair: min(pair[1]))
+    ):
+        node_id = f"n{cluster_index + 1}"
+        coordinates = [endpoint_records[index]["point"] for index in members]
+        geometry_ids = sorted({
+            endpoint_records[index]["geometry_id"]
+            for index in members
+            if isinstance(endpoint_records[index]["geometry_id"], int)
+        })
+        path_indices = sorted({
+            endpoint_records[index]["path_index"] for index in members
+        })
+        nodes.append({
+            "node_id": node_id,
+            "x_mm": round(sum(point[0] for point in coordinates) / len(coordinates), 9),
+            "y_mm": round(sum(point[1] for point in coordinates) / len(coordinates), 9),
+            "geometry_ids": geometry_ids,
+            "path_indices": path_indices,
+        })
+        for index in members:
+            node_by_record[index] = node_id
+
+    edges: list[dict[str, Any]] = []
+    for edge_index, record in enumerate(path_records):
+        start_node = node_by_record[record["start_record"]]
+        end_node = node_by_record[record["end_record"]]
+        edges.append({
+            "edge_id": f"e{edge_index + 1}",
+            "geometry_id": record["geometry_id"],
+            "path_index": record["path_index"],
+            "geometry_type": record["geometry_type"],
+            "start_node": start_node,
+            "end_node": end_node,
+            "closed": start_node == end_node,
+            "point_count": len(record["points"]),
+            "length_mm": round(float(record["length_mm"]), 9),
+        })
+
+    degree = {node["node_id"]: 0 for node in nodes}
+    incident: dict[str, list[dict[str, Any]]] = {node["node_id"]: [] for node in nodes}
+    for edge in edges:
+        start_node, end_node = edge["start_node"], edge["end_node"]
+        incident[start_node].append(edge)
+        if start_node == end_node:
+            degree[start_node] += 2
+        else:
+            degree[start_node] += 1
+            degree[end_node] += 1
+            incident[end_node].append(edge)
+
+    for node in nodes:
+        node_id = node["node_id"]
+        node["degree"] = degree[node_id]
+        roles: list[str] = []
+        if degree[node_id] == 1:
+            roles.append("endpoint")
+        elif degree[node_id] >= 3:
+            roles.append("junction")
+        elif degree[node_id] == 2:
+            roles.append("through")
+        if any(edge["closed"] and edge["start_node"] == node_id for edge in edges):
+            roles.append("closed")
+        node["roles"] = roles
+
+    component_parents = {node["node_id"]: node["node_id"] for node in nodes}
+
+    def component_find(node_id: str) -> str:
+        while component_parents[node_id] != node_id:
+            component_parents[node_id] = component_parents[component_parents[node_id]]
+            node_id = component_parents[node_id]
+        return node_id
+
+    def component_union(left: str, right: str) -> None:
+        left_root, right_root = component_find(left), component_find(right)
+        if left_root != right_root:
+            component_parents[right_root] = left_root
+
+    for edge in edges:
+        component_union(edge["start_node"], edge["end_node"])
+
+    edges_by_component: dict[str, list[dict[str, Any]]] = {}
+    nodes_by_component: dict[str, list[str]] = {}
+    for edge in edges:
+        edges_by_component.setdefault(component_find(edge["start_node"]), []).append(edge)
+    for node in nodes:
+        nodes_by_component.setdefault(component_find(node["node_id"]), []).append(node["node_id"])
+
+    chains: list[dict[str, Any]] = []
+    visited_edges: set[str] = set()
+
+    def walk_chain(start_node: str, first_edge: dict[str, Any]) -> None:
+        node_ids = [start_node]
+        edge_ids: list[str] = []
+        current_node = start_node
+        current_edge: dict[str, Any] | None = first_edge
+        while current_edge is not None and current_edge["edge_id"] not in visited_edges:
+            visited_edges.add(current_edge["edge_id"])
+            edge_ids.append(current_edge["edge_id"])
+            other = (
+                current_edge["end_node"]
+                if current_edge["start_node"] == current_node
+                else current_edge["start_node"]
+            )
+            node_ids.append(other)
+            if other == start_node or degree[other] != 2:
+                break
+            current_node = other
+            candidates = [
+                edge for edge in incident[current_node]
+                if edge["edge_id"] not in visited_edges
+            ]
+            current_edge = candidates[0] if candidates else None
+        chain_index = len(chains) + 1
+        chain_geometry_ids = sorted({
+            edge["geometry_id"] for edge in edges
+            if edge["edge_id"] in edge_ids and isinstance(edge["geometry_id"], int)
+        })
+        closed = node_ids[0] == node_ids[-1]
+        chains.append({
+            "chain_id": f"c{chain_index}",
+            "closed": closed,
+            "node_ids": node_ids,
+            "edge_ids": edge_ids,
+            "geometry_ids": chain_geometry_ids,
+            "free_endpoint_count": sum(
+                1 for node_id in (node_ids[0], node_ids[-1]) if degree[node_id] == 1
+            ),
+        })
+
+    for component_root, component_edges in edges_by_component.items():
+        component_nodes = nodes_by_component[component_root]
+        terminals = [node_id for node_id in component_nodes if degree[node_id] != 2]
+        for node_id in terminals:
+            for edge in incident[node_id]:
+                if edge["edge_id"] not in visited_edges:
+                    walk_chain(node_id, edge)
+        for edge in component_edges:
+            if edge["edge_id"] not in visited_edges:
+                walk_chain(edge["start_node"], edge)
+
+    component_count = len(edges_by_component)
+    free_endpoint_count = sum(1 for node in nodes if node["degree"] == 1)
+    junction_count = sum(1 for node in nodes if node["degree"] >= 3)
+    open_chain_count = sum(1 for chain in chains if not chain["closed"])
+    closed_chain_count = sum(1 for chain in chains if chain["closed"])
+
+    return {
+        "schema": "cad.geometry-graph.v1",
+        "tolerance_mm": tolerance_mm,
+        "tolerance_source": "junction_exact",
+        "distance_method": "euclidean",
+        "nodes": nodes,
+        "edges": edges,
+        "chains": chains,
+        "node_count": len(nodes),
+        "edge_count": len(edges),
+        "component_count": component_count,
+        "open_chain_count": open_chain_count,
+        "closed_chain_count": closed_chain_count,
+        "free_endpoint_count": free_endpoint_count,
+        "junction_count": junction_count,
+    }
+
+
