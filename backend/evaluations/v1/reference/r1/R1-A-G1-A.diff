@@ -0,0 +1,152 @@
+from __future__ import annotations
+
+import pytest
+
+from app.agent_skills import analyze_geometry_topology
+
+
+def line(geometry_id: int, start: tuple[float, float], end: tuple[float, float]) -> dict:
+    return {
+        "id": geometry_id,
+        "type": "line",
+        "layer_id": 1,
+        "start": {"x": start[0], "y": start[1], "z": 0},
+        "end": {"x": end[0], "y": end[1], "z": 0},
+    }
+
+
+def graph_counts(result: dict) -> tuple[int, int, int, int]:
+    graph = result["graph"]
+    return (
+        graph["component_count"],
+        graph["open_chain_count"],
+        graph["closed_chain_count"],
+        graph["free_endpoint_count"],
+    )
+
+
+def test_geometry_graph_four_line_square_is_one_closed_chain():
+    geometries = [
+        line(1, (0, 0), (1000, 0)),
+        line(2, (1000, 0), (1000, 1000)),
+        line(3, (1000, 1000), (0, 1000)),
+        line(4, (0, 1000), (0, 0)),
+    ]
+
+    result = analyze_geometry_topology(geometries)
+    graph = result["graph"]
+
+    assert graph["schema"] == "cad.geometry-graph.v1"
+    assert graph["distance_method"] == "euclidean"
+    assert graph_counts(result) == (1, 0, 1, 0)
+    assert graph["node_count"] == 4
+    assert graph["edge_count"] == 4
+    assert graph["junction_count"] == 0
+    assert graph["chains"][0]["node_ids"][0] == graph["chains"][0]["node_ids"][-1]
+
+
+def test_geometry_graph_three_connected_lines_is_one_open_chain():
+    geometries = [
+        line(1, (0, 0), (1000, 0)),
+        line(2, (1000, 0), (2000, 0)),
+        line(3, (2000, 0), (3000, 0)),
+    ]
+
+    result = analyze_geometry_topology(geometries)
+    graph = result["graph"]
+
+    assert graph_counts(result) == (1, 1, 0, 2)
+    assert graph["node_count"] == 4
+    assert graph["edge_count"] == 3
+    assert sorted(node["degree"] for node in graph["nodes"]) == [1, 1, 2, 2]
+    assert graph["chains"][0]["geometry_ids"] == [1, 2, 3]
+
+
+def test_geometry_graph_uses_true_distance_not_legacy_grid():
+    within_tolerance = [
+        line(1, (0, 0), (1000.0, 0)),
+        line(2, (1000.0000005, 0), (2000, 0)),
+    ]
+    outside_tolerance = [
+        line(1, (0, 0), (1000.0, 0)),
+        line(2, (1000.0000015, 0), (2000, 0)),
+    ]
+    legacy_grid_connected = [
+        line(1, (0, 0), (1000.6, 0)),
+        line(2, (1001.4, 0), (2000, 0)),
+    ]
+
+    assert graph_counts(analyze_geometry_topology(within_tolerance))[0] == 1
+    assert graph_counts(analyze_geometry_topology(outside_tolerance))[0] == 2
+
+    legacy = analyze_geometry_topology(legacy_grid_connected)
+    assert legacy["disconnected_component_count"] == 1
+    assert legacy["graph"]["component_count"] == 2
+
+
+def test_geometry_graph_preserves_geometry_identity():
+    geometries = [
+        line(11, (0, 0), (1000, 0)),
+        line(22, (1000, 0), (1000, 1000)),
+        line(33, (1000, 1000), (0, 1000)),
+        line(44, (0, 1000), (0, 0)),
+    ]
+
+    graph = analyze_geometry_topology(geometries)["graph"]
+
+    assert [edge["geometry_id"] for edge in graph["edges"]] == [11, 22, 33, 44]
+    assert all(edge["length_mm"] > 0 for edge in graph["edges"])
+    shared_nodes = [
+        node for node in graph["nodes"] if len(node["geometry_ids"]) == 2
+    ]
+    assert len(shared_nodes) == 4
+    assert all(set(node["geometry_ids"]) for node in shared_nodes)
+
+
+def test_geometry_graph_single_closed_path_is_a_loop():
+    geometry = {
+        "id": 7,
+        "type": "polyline",
+        "layer_id": 1,
+        "closed": True,
+        "vertices": [
+            {"x": 0, "y": 0, "z": 0},
+            {"x": 1000, "y": 0, "z": 0},
+            {"x": 1000, "y": 1000, "z": 0},
+            {"x": 0, "y": 1000, "z": 0},
+        ],
+    }
+
+    result = analyze_geometry_topology([geometry])
+    graph = result["graph"]
+
+    assert graph_counts(result) == (1, 0, 1, 0)
+    assert graph["node_count"] == 1
+    assert graph["edges"][0]["start_node"] == graph["edges"][0]["end_node"]
+    assert graph["nodes"][0]["degree"] == 2
+    assert graph["edges"][0]["geometry_id"] == 7
+
+
+def test_geometry_graph_empty_input_is_empty():
+    graph = analyze_geometry_topology([])["graph"]
+
+    assert graph["nodes"] == []
+    assert graph["edges"] == []
+    assert graph["chains"] == []
+    assert graph_counts({"graph": graph}) == (0, 0, 0, 0)
+
+
+def test_geometry_graph_keeps_legacy_counts_additive():
+    geometries = [
+        line(1, (0, 0), (1000, 0)),
+        line(2, (1000, 0), (1000, 1000)),
+        line(3, (1000, 1000), (0, 1000)),
+        line(4, (0, 1000), (0, 0)),
+    ]
+
+    result = analyze_geometry_topology(geometries)
+
+    assert result["open_chain_count"] == 4
+    assert result["closed_loop_count"] == 0
+    assert result["endpoint_count"] == 8
+    assert graph_counts(result) == (1, 0, 1, 0)
