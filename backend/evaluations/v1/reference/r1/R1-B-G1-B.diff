+def _sample_cubic_bezier(geometry: dict[str, Any]) -> list[list[float]]:
+    control_points = _valid_points(
+        geometry.get("control_points") or geometry.get("controlPoints") or []
+    )
+    if len(control_points) != 4:
+        return []
+    p0, p1, p2, p3 = control_points
+    points: list[list[float]] = []
+    for sample in range(CURVE_SAMPLES + 1):
+        t = sample / CURVE_SAMPLES
+        one_minus_t = 1.0 - t
+        b0 = one_minus_t ** 3
+        b1 = 3.0 * one_minus_t ** 2 * t
+        b2 = 3.0 * one_minus_t * t ** 2
+        b3 = t ** 3
+        points.append([
+            b0 * p0[0] + b1 * p1[0] + b2 * p2[0] + b3 * p3[0],
+            b0 * p0[1] + b1 * p1[1] + b2 * p2[1] + b3 * p3[1],
+        ])
+    return points
+
