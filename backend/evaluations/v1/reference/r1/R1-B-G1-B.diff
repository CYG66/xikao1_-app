diff --git a/tests/test_geometry_topology_types.py b/tests/test_geometry_topology_types.py
new file mode 100644
index 00000000..71a4960e
--- /dev/null
+++ b/tests/test_geometry_topology_types.py
@@ -0,0 +1,211 @@
+from __future__ import annotations
+
+import pytest
+
+from app.agent_skills import analyze_geometry_topology
+from app.drawing_store import geometry_preview_paths
+from app.tooling import CadCubicBezier, CadSpline
+
+
+def point(x: float, y: float) -> dict[str, float]:
+    return {"x": x, "y": y, "z": 0.0}
+
+
+@pytest.fixture
+def cubic_control_points() -> list[dict[str, float]]:
+    return [
+        point(0.0, 0.0),
+        point(300.0, 1000.0),
+        point(700.0, 1000.0),
+        point(1000.0, 0.0),
+    ]
+
+
+def _normalized(result: dict) -> dict:
+    assert len(result["curve_types"]) == 1
+    return result["curve_types"][0]
+
+
+def test_native_cubic_bezier_is_first_class(cubic_control_points):
+    geometry = CadCubicBezier(
+        id=7,
+        type="cubic_bezier",
+        control_points=cubic_control_points,
+    ).model_dump()
+
+    result = analyze_geometry_topology([geometry])
+    record = _normalized(result)
+
+    assert record["topology_type"] == "CubicBezier"
+    assert record["supported"] is True
+    assert record["fail_closed"] is False
+    assert record["evidence_source"] == "native_type"
+    assert record["geometry_id"] == 7
+    assert [item["x"] for item in record["control_points"]] == [0.0, 300.0, 700.0, 1000.0]
+    assert [item["y"] for item in record["control_points"]] == [0.0, 1000.0, 1000.0, 0.0]
+    assert record["degree"] == 3
+    assert record["basis"] == "bernstein"
+    assert record["parameter_domain"] == [0.0, 1.0]
+
+    edge = result["graph"]["edges"][0]
+    assert edge["geometry_id"] == 7
+    assert edge["topology_type"] == "CubicBezier"
+    assert edge["point_count"] == 65
+
+
+def test_legacy_spline_with_explicit_provenance_maps_to_cubic_bezier(cubic_control_points):
+    geometry = {
+        "id": 8,
+        "type": "spline",
+        "degree": 3,
+        "control_points": cubic_control_points,
+        "closed": False,
+        "bezier_provenance": {
+            "source": "add_bezier",
+            "degree": 3,
+            "control_point_count": 4,
+            "basis": "bernstein",
+            "parameter_domain": [0.0, 1.0],
+        },
+    }
+
+    result = analyze_geometry_topology([geometry])
+    record = _normalized(result)
+
+    assert record["topology_type"] == "CubicBezier"
+    assert record["supported"] is True
+    assert record["fail_closed"] is False
+    assert record["evidence_source"] == "legacy_provenance"
+    assert record["geometry_id"] == 8
+    assert record["control_point_count"] == 4
+    assert record["parameter_domain"] == [0.0, 1.0]
+
+
+def test_legacy_spline_without_evidence_is_generic_not_cubic(cubic_control_points):
+    geometry = {
+        "id": 9,
+        "type": "spline",
+        "degree": 3,
+        "control_points": cubic_control_points,
+        "closed": False,
+    }
+
+    result = analyze_geometry_topology([geometry])
+    record = _normalized(result)
+
+    assert record["topology_type"] == "GenericSpline"
+    assert record["topology_type"] != "CubicBezier"
+    assert record["supported"] is False
+    assert record["fail_closed"] is False
+    assert record["geometry_id"] == 9
+    assert record["control_point_count"] == 4
+    assert record["degree"] == 3
+    assert record["parameter_domain"] is None
+
+
+def test_non_cubic_curve_is_not_promoted(cubic_control_points):
+    geometry = {
+        "id": 10,
+        "type": "spline",
+        "degree": 2,
+        "control_points": cubic_control_points[:3],
+        "curve_kind": "cubic_bezier",
+        "basis": "bernstein",
+        "parameter_domain": [0.0, 1.0],
+    }
+
+    result = analyze_geometry_topology([geometry])
+    record = _normalized(result)
+
