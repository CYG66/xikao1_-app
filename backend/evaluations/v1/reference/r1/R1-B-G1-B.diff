diff --git a/app/cad_topology_types.py b/app/cad_topology_types.py
new file mode 100644
index 00000000..71423c27
--- /dev/null
+++ b/app/cad_topology_types.py
@@ -0,0 +1,349 @@
+"""Topology-level curve identity normalization.
+
+This module is deliberately separate from the geometry engine.  It only
+classifies existing geometry dictionaries into the topology contract:
+Line, CubicBezier, GenericSpline and UnknownCurve.  A legacy ``spline`` is
+never promoted merely because it has four control points or degree three.
+
+CubicBezier is defined here as the cubic Bernstein form
+
+    B(t) = (1-t)^3 P0 + 3(1-t)^2 t P1 + 3(1-t)t^2 P2 + t^3 P3
+
+with exactly four ordered control points and t in the canonical domain
+[0.0, 1.0].  The order P0..P3 is preserved in all normalized output.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+TOPOLOGY_LINE = "Line"
+TOPOLOGY_CUBIC_BEZIER = "CubicBezier"
+TOPOLOGY_GENERIC_SPLINE = "GenericSpline"
+TOPOLOGY_UNKNOWN_CURVE = "UnknownCurve"
+
+CUBIC_BEZIER_CONTROL_POINT_COUNT = 4
+CUBIC_BEZIER_DEGREE = 3
+CUBIC_BEZIER_BASIS = "bernstein"
+CUBIC_BEZIER_PARAMETER_DOMAIN = (0.0, 1.0)
+
+_NATIVE_CUBIC_TYPES = {"cubic_bezier", "cubic-bezier", "cubicbezier"}
+_GENERIC_SPLINE_TYPES = {"spline", "bspline", "b_spline"}
+_UNKNOWN_CURVE_TYPES = {"curve", "unknown_curve", "bezier", "quadratic_bezier"}
+_CUBIC_EVIDENCE_SOURCES = {
+    "add_bezier",
+    "cubic_bezier",
+    "cubic-bezier",
+    "cubicbezier",
+    "bezier_cubic",
+}
+_CURVE_SCOPE_TYPES = (
+    _NATIVE_CUBIC_TYPES
+    | _GENERIC_SPLINE_TYPES
+    | _UNKNOWN_CURVE_TYPES
+    | {"line"}
+)
+
+
+def _lower(value: Any) -> str:
+    return str(value or "").strip().lower()
+
+
+def _geometry_id(geometry: dict[str, Any]) -> int | None:
+    value = geometry.get("id")
+    if isinstance(value, int) and value > 0:
+        return value
+    return None
+
+
+def _control_points(geometry: dict[str, Any]) -> list[dict[str, float]]:
+    raw = geometry.get("control_points")
+    if raw is None:
+        raw = geometry.get("controlPoints")
+    if not isinstance(raw, list):
+        return []
+    points: list[dict[str, float]] = []
+    for item in raw:
+        if not isinstance(item, dict):
+            continue
+        try:
+            points.append({
+                "x": float(item["x"]),
+                "y": float(item["y"]),
+                "z": float(item.get("z", 0.0)),
+            })
+        except (KeyError, TypeError, ValueError):
+            continue
+    return points
+
+
+def _parameter_domain(value: Any) -> tuple[float, float] | None:
+    if not isinstance(value, (list, tuple)) or len(value) != 2:
+        return None
+    try:
+        start, end = float(value[0]), float(value[1])
+    except (TypeError, ValueError):
+        return None
+    return (start, end)
+
+
+def _int_or_none(value: Any) -> int | None:
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return None
+
+
+def _legacy_evidence(geometry: dict[str, Any]) -> dict[str, Any] | None:
+    provenance = geometry.get("bezier_provenance")
+    if isinstance(provenance, dict):
+        evidence = dict(provenance)
+        for key in (
+            "source",
+            "degree",
+            "control_point_count",
+            "basis",
+            "parameter_domain",
+        ):
+            if evidence.get(key) in (None, ""):
+                evidence[key] = geometry.get(key)
+        source = (
+            evidence.get("source")
+            or geometry.get("curve_kind")
+            or geometry.get("curve_type")
+            or geometry.get("construction_op")
+        )
+        evidence["source"] = source
+        if _lower(source) not in _CUBIC_EVIDENCE_SOURCES:
+            return None
+        if evidence.get("control_point_count") in (None, ""):
+            evidence["control_point_count"] = len(_control_points(geometry))
+        return evidence
+    source = (
+        geometry.get("curve_kind")
+        or geometry.get("curve_type")
+        or geometry.get("construction_op")
+    )
+    if _lower(source) not in _CUBIC_EVIDENCE_SOURCES:
+        return None
+    return {
+        "source": source,
+        "degree": geometry.get("degree"),
+        "control_point_count": len(_control_points(geometry)),
+        "basis": geometry.get("basis"),
+        "parameter_domain": geometry.get("parameter_domain"),
+    }
+
+
+def _curve_result(
+    geometry: dict[str, Any],
+    input_index: int,
+    *,
+    topology_type: str,
+    supported: bool,
+    fail_closed: bool,
+    evidence_source: str,
+    control_points: list[dict[str, float]],
+    degree: int | None,
+    basis: str | None,
+    parameter_domain: tuple[float, float] | None,
+    issues: list[str],
+    status: str,
+) -> dict[str, Any]:
+    return {
+        "input_index": input_index,
+        "geometry_id": _geometry_id(geometry),
+        "source_type": _lower(geometry.get("type") or "line"),
+        "topology_type": topology_type,
+        "status": status,
+        "supported": supported,
+        "fail_closed": fail_closed,
+        "evidence_source": evidence_source,
+        "control_points": control_points,
+        "control_point_count": len(control_points),
+        "degree": degree,
+        "basis": basis,
+        "parameter_domain": list(parameter_domain) if parameter_domain else None,
+        "issues": issues,
+    }
+
+
+def normalize_curve_geometry(
+    geometry: dict[str, Any], input_index: int = 0
+) -> dict[str, Any] | None:
+    """Normalize one geometry dictionary without mutating it.
+
+    Returns ``None`` for geometry families outside the curve contract.
+    """
+    if not isinstance(geometry, dict):
+        return None
+    source_type = _lower(geometry.get("type") or "line")
+    if source_type not in _CURVE_SCOPE_TYPES:
+        return None
+
+    if source_type == "line":
+        return _curve_result(
+            geometry,
+            input_index,
+            topology_type=TOPOLOGY_LINE,
+            supported=True,
+            fail_closed=False,
+            evidence_source="native_type",
+            control_points=[],
+            degree=None,
+            basis=None,
+            parameter_domain=None,
+            issues=[],
+            status="line",
+        )
+
+    control_points = _control_points(geometry)
+    if source_type in _NATIVE_CUBIC_TYPES:
+        basis = _lower(geometry.get("basis") or CUBIC_BEZIER_BASIS)
+        domain = _parameter_domain(
+            geometry.get("parameter_domain", list(CUBIC_BEZIER_PARAMETER_DOMAIN))
+        )
+        degree_value = geometry.get("degree", CUBIC_BEZIER_DEGREE)
+        try:
+            degree = int(degree_value)
+        except (TypeError, ValueError):
+            degree = -1
+        issues: list[str] = []
+        if len(control_points) != CUBIC_BEZIER_CONTROL_POINT_COUNT:
+            issues.append("cubic_bezier_requires_four_control_points")
+        if degree != CUBIC_BEZIER_DEGREE:
+            issues.append("cubic_bezier_requires_degree_three")
+        if basis != CUBIC_BEZIER_BASIS:
+            issues.append("cubic_bezier_requires_bernstein_basis")
+        if domain != CUBIC_BEZIER_PARAMETER_DOMAIN:
+            issues.append("cubic_bezier_requires_unit_parameter_domain")
+        if issues:
+            return _curve_result(
+                geometry,
+                input_index,
+                topology_type=TOPOLOGY_UNKNOWN_CURVE,
+                supported=False,
+                fail_closed=True,
+                evidence_source="native_type_rejected",
+                control_points=control_points,
+                degree=degree if degree >= 0 else None,
+                basis=basis,
+                parameter_domain=domain,
+                issues=issues,
+                status="unknown_curve",
+            )
+        return _curve_result(
+            geometry,
+            input_index,
+            topology_type=TOPOLOGY_CUBIC_BEZIER,
+            supported=True,
+            fail_closed=False,
+            evidence_source="native_type",
+            control_points=control_points,
+            degree=CUBIC_BEZIER_DEGREE,
+            basis=CUBIC_BEZIER_BASIS,
+            parameter_domain=CUBIC_BEZIER_PARAMETER_DOMAIN,
+            issues=[],
+            status="native_cubic_bezier",
+        )
+
+    evidence = _legacy_evidence(geometry)
+    if evidence is not None:
+        basis = _lower(evidence.get("basis"))
+        domain = _parameter_domain(evidence.get("parameter_domain"))
+        degree_value = evidence.get("degree", geometry.get("degree"))
+        try:
+            degree = int(degree_value)
+        except (TypeError, ValueError):
+            degree = -1
+        try:
+            declared_count = int(
+                evidence.get(
+                    "control_point_count",
+                    geometry.get("control_point_count", len(control_points)),
+                )
+            )
+        except (TypeError, ValueError):
+            declared_count = -1
+        issues: list[str] = []
+        if len(control_points) != CUBIC_BEZIER_CONTROL_POINT_COUNT:
+            issues.append("legacy_bezier_requires_four_control_points")
+        if declared_count != CUBIC_BEZIER_CONTROL_POINT_COUNT:
+            issues.append("legacy_bezier_declared_count_mismatch")
+        if degree != CUBIC_BEZIER_DEGREE:
+            issues.append("legacy_bezier_requires_degree_three")
+        if basis != CUBIC_BEZIER_BASIS:
+            issues.append("legacy_bezier_requires_bernstein_basis")
+        if domain != CUBIC_BEZIER_PARAMETER_DOMAIN:
+            issues.append("legacy_bezier_requires_unit_parameter_domain")
+        if issues:
+            return _curve_result(
+                geometry,
+                input_index,
+                topology_type=TOPOLOGY_UNKNOWN_CURVE,
+                supported=False,
+                fail_closed=True,
+                evidence_source="legacy_provenance_rejected",
+                control_points=control_points,
+                degree=degree if degree >= 0 else None,
+                basis=basis or None,
+                parameter_domain=domain,
+                issues=issues,
+                status="unknown_curve",
+            )
+        return _curve_result(
+            geometry,
+            input_index,
+            topology_type=TOPOLOGY_CUBIC_BEZIER,
+            supported=True,
+            fail_closed=False,
+            evidence_source="legacy_provenance",
+            control_points=control_points,
+            degree=CUBIC_BEZIER_DEGREE,
+            basis=CUBIC_BEZIER_BASIS,
+            parameter_domain=CUBIC_BEZIER_PARAMETER_DOMAIN,
+            issues=[],
+            status="legacy_cubic_bezier",
+        )
+
+    if source_type in _UNKNOWN_CURVE_TYPES:
+        return _curve_result(
+            geometry,
+            input_index,
+            topology_type=TOPOLOGY_UNKNOWN_CURVE,
+            supported=False,
+            fail_closed=True,
+            evidence_source="unconfirmed_curve_semantics",
+            control_points=control_points,
+            degree=None,
+            basis=None,
+            parameter_domain=None,
+            issues=["curve_semantics_not_proven"],
+            status="unknown_curve",
+        )
+
+    return _curve_result(
+        geometry,
+        input_index,
+        topology_type=TOPOLOGY_GENERIC_SPLINE,
+        supported=False,
+        fail_closed=False,
+        evidence_source="generic_spline",
+        control_points=control_points,
+        degree=_int_or_none(geometry.get("degree")),
+        basis=None,
+        parameter_domain=None,
+        issues=[],
+        status="generic_spline",
+    )
+
+
+def normalize_curve_types(geometries: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Normalize all curve-bearing geometries in input order."""
+    result: list[dict[str, Any]] = []
+    for input_index, geometry in enumerate(geometries):
+        normalized = normalize_curve_geometry(geometry, input_index)
+        if normalized is not None:
+            result.append(normalized)
+    return result
