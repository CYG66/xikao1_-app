[
  {
    "case": "C3",
    "original": "生成一个半圆拱门轮廓，宽2米高3米",
    "source": "生成一个半圆拱门轮廓，宽2米高3米\n顶部为半径1米的上半圆；两侧直墙各长2米；底边闭合。整体宽度2米、整体高度3米，坐标单位米。",
    "plan": {
      "shared_points": {},
      "schema_version": "cad.construction-plan.v1",
      "units": "m",
      "project_id": null,
      "source_version": null,
      "steps": [
        {
          "step_id": "arch.outline",
          "output_ref": "arch_outline",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "semicircle_arch",
            "assembly_label": "半圆拱门轮廓",
            "object_id": "arch_outline",
            "object_type": "drawing_part",
            "label": "半圆拱门完整闭合轮廓",
            "role": "outer_boundary"
          },
          "op": "add_composite_path",
          "segments": [
            {
              "kind": "line",
              "start": {
                "x": -1.0,
                "y": 0.0
              },
              "end": {
                "x": -1.0,
                "y": 2.0
              }
            },
            {
              "kind": "arc",
              "center": {
                "x": 0.0,
                "y": 2.0
              },
              "radius": 1.0,
              "start_angle": 180.0,
              "end_angle": 0.0,
              "clockwise": true
            },
            {
              "kind": "line",
              "start": {
                "x": 1.0,
                "y": 2.0
              },
              "end": {
                "x": 1.0,
                "y": 0.0
              }
            },
            {
              "kind": "line",
              "start": {
                "x": 1.0,
                "y": 0.0
              },
              "end": {
                "x": -1.0,
                "y": 0.0
              }
            }
          ],
          "closed": true,
          "samples_per_curve": 32,
          "connection_tolerance": 1e-06,
          "continuity": "C0",
          "tangent_tolerance_deg": 1.0,
          "allow_self_intersection": false,
          "allow_duplicate_segments": false,
          "max_curvature": null,
          "max_sampling_error": null,
          "junction_constraints": []
        }
      ],
      "constraints": [],
      "constraint_backend": "auto",
      "assertions": [
        {
          "kind": "closed",
          "assertion_id": "arch_closed",
          "target_ref": "arch_outline"
        },
        {
          "kind": "bounds_size",
          "assertion_id": "arch_bounds",
          "target_ref": "arch_outline",
          "width": 2.0,
          "height": 3.0,
          "tolerance": 0.001
        },
        {
          "kind": "entity_count",
          "assertion_id": "arch_entities",
          "target_ref": "arch_outline",
          "equals": 1
        }
      ],
      "budgets": {
        "max_steps": 100,
        "max_entities": 500
      },
      "free_outline_layout": []
    }
  },
  {
    "case": "C6",
    "original": "画一朵花的轮廓，5片花瓣，闭合曲线",
    "source": "画一朵花的轮廓，5片花瓣，闭合曲线\n宽度5米，高度5米。",
    "plan": {
      "shared_points": {},
      "schema_version": "cad.construction-plan.v1",
      "units": "m",
      "project_id": null,
      "source_version": null,
      "steps": [
        {
          "step_id": "flower.petal.curve",
          "output_ref": "flower_outline",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "flower",
            "assembly_label": "花的轮廓",
            "object_id": "flower_outline",
            "object_type": "drawing_part",
            "label": "五瓣花闭合外轮廓",
            "role": "outer_boundary"
          },
          "op": "add_parametric_curve",
          "x_expression": "2.5*cos(t)*(1+0.35*cos(5*t))",
          "y_expression": "2.5*sin(t)*(1+0.35*cos(5*t))",
          "t_start": "0",
          "t_end": "2*pi",
          "max_sampling_error": 0.001,
          "closed": true
        }
      ],
      "constraints": [],
      "constraint_backend": "auto",
      "assertions": [
        {
          "kind": "closed",
          "assertion_id": "flower.closed",
          "target_ref": "flower_outline"
        },
        {
          "kind": "bounds_size",
          "assertion_id": "explicit-outline-size",
          "target_ref": "flower_outline",
          "width": 5.0,
          "height": 5.0,
          "tolerance": 0.001
        },
        {
          "kind": "entity_count",
          "assertion_id": "required-outline-count",
          "target_ref": null,
          "equals": 1
        },
        {
          "kind": "radial_pattern",
          "assertion_id": "requested-radial-pattern",
          "target_ref": "flower_outline",
          "lobes": 5,
          "profile": "smooth"
        }
      ],
      "budgets": {
        "max_steps": 100,
        "max_entities": 500
      },
      "free_outline_layout": [
        {
          "target_ref": "flower_outline",
          "width": 5.0,
          "height": 5.0,
          "right_of_ref": null,
          "gap": 0.0,
          "gap_reference": "edge",
          "center": null
        }
      ]
    }
  },
