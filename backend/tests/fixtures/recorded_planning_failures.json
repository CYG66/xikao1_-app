    "case": "C12",
    "original": "生成一个阿基米德螺旋线，从(0,0)出发，旋转3圈，最大半径2米",
    "source": "生成一个阿基米德螺旋线，从(0,0)出发，旋转3圈，最大半径2米\n坐标单位为米，从原点开始，逆时针旋转3圈，半径从0线性增长到2米。",
    "plan": {
      "shared_points": {},
      "schema_version": "cad.construction-plan.v1",
      "units": "m",
      "project_id": null,
      "source_version": null,
      "steps": [
        {
          "step_id": "spiral",
          "output_ref": "archimedean_spiral",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "archimedean_spiral",
            "assembly_label": "阿基米德螺旋线",
            "object_id": "spiral_curve",
            "object_type": "curve",
            "label": "阿基米德螺旋线主曲线",
            "role": "outline"
          },
          "op": "add_parametric_curve",
          "x_expression": "(2*t/(6*pi))*cos(t)",
          "y_expression": "(2*t/(6*pi))*sin(t)",
          "t_start": "0",
          "t_end": "6*pi",
          "max_sampling_error": 0.001,
          "closed": false
        }
      ],
      "constraints": [],
      "constraint_backend": "auto",
      "assertions": [
        {
          "kind": "bounds_size",
          "assertion_id": "spiral_bounds",
          "target_ref": "archimedean_spiral",
          "width": 4.0,
          "height": 0.0,
          "tolerance": 0.5
        }
      ],
      "budgets": {
        "max_steps": 100,
        "max_entities": 500
      },
      "free_outline_layout": []
    }
  },
