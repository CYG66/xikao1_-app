  {
    "case": "C31",
    "original": "生成一个太极图，外圆半径2米，S形分割线，两个对称小圆",
    "source": "生成一个太极图，外圆半径2米，S形分割线，两个对称小圆\n外圆半径2米，S形分割线和两个对称小圆，坐标单位米；保持原始太极图要求，只生成预览。",
    "plan": {
      "shared_points": {},
      "schema_version": "cad.construction-plan.v1",
      "units": "m",
      "project_id": null,
      "source_version": null,
      "steps": [
        {
          "step_id": "taiji.outer.circle",
          "output_ref": "taiji_outer_circle",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "taiji_diagram",
            "assembly_label": "太极图",
            "object_id": "taiji_outer_ring",
            "object_type": "drawing_part",
            "label": "太极图外圆",
            "role": "outer_boundary"
          },
          "op": "add_circle",
          "center": {
            "x": 0.0,
            "y": 0.0
          },
          "radius": 2.0
        },
        {
          "step_id": "taiji.s.divider",
          "output_ref": "taiji_s_divider",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "taiji_diagram",
            "assembly_label": "太极图",
            "object_id": "taiji_s_divider_curve",
            "object_type": "drawing_part",
            "label": "S形分割线",
            "role": "split_line"
          },
          "op": "add_composite_path",
          "segments": [
            {
              "kind": "arc",
              "center": {
                "x": 0.0,
                "y": 1.0
              },
              "radius": 1.0,
              "start_angle": 90.0,
              "end_angle": 270.0,
              "clockwise": true
            },
            {
              "kind": "arc",
              "center": {
                "x": 0.0,
                "y": -1.0
              },
              "radius": 1.0,
              "start_angle": 90.0,
              "end_angle": 270.0,
              "clockwise": false
            }
          ],
          "closed": false,
          "samples_per_curve": 32,
          "connection_tolerance": 1e-06,
          "continuity": "C0",
          "tangent_tolerance_deg": 1.0,
          "allow_self_intersection": false,
          "allow_duplicate_segments": false,
          "max_curvature": null,
          "max_sampling_error": null,
          "junction_constraints": []
        },
        {
          "step_id": "taiji.small.circle.top",
          "output_ref": "taiji_small_circle_top",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "taiji_diagram",
            "assembly_label": "太极图",
            "object_id": "taiji_small_circle_upper",
            "object_type": "drawing_part",
            "label": "上方对称小圆",
            "role": "small_circle"
          },
          "op": "add_circle",
          "center": {
            "x": 0.0,
            "y": 0.8
          },
          "radius": 0.35
        },
        {
          "step_id": "taiji.small.circle.bottom",
          "output_ref": "taiji_small_circle_bottom",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "taiji_diagram",
            "assembly_label": "太极图",
            "object_id": "taiji_small_circle_lower",
            "object_type": "drawing_part",
            "label": "下方对称小圆",
            "role": "small_circle"
          },
          "op": "add_circle",
          "center": {
            "x": 0.0,
            "y": -0.8
          },
          "radius": 0.35
        }
      ],
      "constraints": [
        {
