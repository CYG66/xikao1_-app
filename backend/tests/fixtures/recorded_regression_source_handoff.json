[
  {
    "case": "C18",
    "original": "生成一个星形线（内凹四角星），最大半径2米",
    "source": "生成一个星形线（内凹四角星），最大半径2米\n使用参数式x=2*cos(t)^3、y=2*sin(t)^3，t从0到2*pi，坐标单位米，闭合。",
    "plan": {
      "shared_points": {},
      "schema_version": "cad.construction-plan.v1",
      "units": "m",
      "project_id": null,
      "source_version": null,
      "steps": [
        {
          "step_id": "step.astroid",
          "output_ref": "astroid_outline",
          "layer_id": 1,
          "semantic": {
            "assembly_id": "astroid",
            "assembly_label": "星形线",
            "object_id": "astroid.curve",
            "object_type": "drawing_part",
            "label": "星形线外轮廓",
            "role": "outer_boundary"
          },
          "op": "add_parametric_curve",
          "x_expression": "2*cos(t)**3",
          "y_expression": "2*sin(t)**3",
          "t_start": "0",
          "t_end": "2*pi",
          "max_sampling_error": 0.001,
          "closed": true
        }
      ],
      "constraints": [],
      "constraint_backend": "auto",
      "assertions": [
        {
          "kind": "closed",
          "assertion_id": "assert.astroid.closed",
          "target_ref": "astroid_outline"
        },
        {
          "kind": "bounds_size",
          "assertion_id": "assert.astroid.bounds",
          "target_ref": "astroid_outline",
          "width": 4.0,
          "height": 4.0,
          "tolerance": 0.01
        }
      ],
      "budgets": {
        "max_steps": 100,
        "max_entities": 500
      },
      "free_outline_layout": []
    }
  },
