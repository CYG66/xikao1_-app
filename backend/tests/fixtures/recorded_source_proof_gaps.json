              "y": 0.0
            },
            "radius": 1.0
          }
        ],
        "constraints": [
          {
            "constraint_id": "equal-lens-radius",
            "target_ref": "right_lens_circle",
            "reference_ref": "left_lens_circle",
            "tolerance": 0.001,
            "kind": "equal_radius"
          },
          {
            "constraint_id": "lens-center-distance",
            "target_ref": "right_lens_circle",
