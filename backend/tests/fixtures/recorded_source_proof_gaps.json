              "y": 0.0
            },
            "radius": 1.0
          },
          {
            "step_id": "right-lens",
            "output_ref": "right_lens_circle",
            "layer_id": 1,
            "semantic": {
              "assembly_id": "glasses_outline",
              "assembly_label": "眼镜轮廓",
