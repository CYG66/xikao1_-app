# Copy to /home/qingz/.config/xline-agent.env on the robot.
XLINE_WS_DIR=/home/qingz/xline_cyg
XLINE_SETUP_FILE=/home/qingz/xline_cyg/install_ws3/setup.bash
XLINE_CAD_DIR=/home/qingz/xline_cyg/cad
XLINE_PLANNED_RESULTS_DIR=/home/qingz/xline_cyg/other/planned_results
XLINE_USE_TOTAL_STATION=false
XLINE_DEVICE_ID=replace_with_unique_device_id
XLINE_VEHICLE_MODEL=XLine Rover
XLINE_SOFTWARE_VERSION=0.1.0
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=600
# Agent 工具审计采用追加写入的 JSONL 文件，不保存 API Key。
XLINE_AGENT_AUDIT_STORE=/home/qingz/.local/state/xline-agent/agent_audit.jsonl
