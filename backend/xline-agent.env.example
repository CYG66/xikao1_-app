# Copy to /home/qingz/.config/xline-agent-ws3.env on the robot.
XLINE_WS_DIR=/home/qingz/xline_ws3
XLINE_WS_ROOT=/home/qingz/xline_ws3
XLINE_SETUP_FILE=/home/qingz/xline_ws3/install/setup.bash
XLINE_CAD_DIR=/home/qingz/xline_ws3/cad
XLINE_PLANNED_RESULTS_DIR=/home/qingz/xline_ws3/other/planned_results
XLINE_USE_TOTAL_STATION=false
XLINE_ENABLE_PRINTER=true
XLINE_RUNTIME_PROFILE=xline_ws3
XLINE_BACKEND_NODE_NAME=xline_app_backend1
XLINE_DEVICE_ID=replace_with_unique_device_id
XLINE_VEHICLE_MODEL="XLine Rover"
XLINE_SOFTWARE_VERSION=0.1.0
XLINE_AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# 普通调用与进阶模式默认均使用 Chat。
DEEPSEEK_BASE_MODEL=deepseek-chat
DEEPSEEK_ADVANCED_MODEL=deepseek-chat
# CAD 构造规划可显式改为 deepseek-reasoner；不改变聊天、意图复核及修改解析模型。
DEEPSEEK_CAD_PLANNING_MODEL=deepseek-chat
# 切换其他提供商时，填写对应的 <PROVIDER>_API_KEY 和 <PROVIDER>_MODEL。
# 各供应商默认模型（须支持 function calling 才能跑完整 Agent：CAD 修改 / 项目生成 / 小车控制）：
# OPENAI_MODEL=gpt-5.1
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-3.6-flash
# QWEN_MODEL=qwen3.7-max
# KIMI_MODEL=kimi-k2.5
# GLM_MODEL=glm-5
# MINIMAX_MODEL=MiniMax-M2.7
# 注意：环境变量优先于后端默认值；请勿使用 moonshot-v1-8k、glm-4-flash、
# MiniMax-Text-01、qwen-plus 等不支持 function calling 的旧模型名。
# Agent 工具审计采用追加写入的 JSONL 文件，不保存 API Key。
XLINE_AGENT_AUDIT_STORE=/home/qingz/.local/state/xline-agent/agent_audit.jsonl
# 仅用于意图路由复核和 CAD 结构化解释，不影响普通聊天的输出额度。
XLINE_AGENT_REVIEW_MAX_TOKENS=700
